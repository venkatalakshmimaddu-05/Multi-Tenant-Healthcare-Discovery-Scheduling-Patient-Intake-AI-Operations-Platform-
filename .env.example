# AuraCare Health Platform - Environment Configuration Example
NODE_ENV=development
PORT=3000

# 1. DATABASE CONFIGURATION
# Default: SQLite (Zero-friction local dev, no server or password needed)
DATABASE_URL="file:./dev.db"

# Production Enterprise Mode: PostgreSQL (via Docker or Cloud DB)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auracare_db?schema=public"

# 2. CACHE & MESSAGE BROKER (Docker / Prod)
REDIS_URL="redis://localhost:6379"

# 3. SECURITY & AUTHENTICATION
JWT_SECRET="auracare_dev_jwt_secret_key_change_in_production"

# 4. EXTERNAL AI & EHR INTEGRATIONS (Optional)
OPENAI_API_KEY=""
